   "type": "stat",
   "title": "Requests in progress",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vad_api_requests_in_progress",
     "legendFormat": "in progress",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Requests per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (endpoint, status) (rate(vad_api_requests_total[5m]))",
     "legendFormat": "{{endpoint}} {{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Request latency (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, endpoint) (rate(vad_api_request_seconds_bucket[5m])))",
     "legendFormat": "p50 {{endpoint}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(vad_api_request_seconds_bucket[5m])))",
     "legendFormat": "p95 {{endpoint}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Error rate (4xx + 5xx)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(vad_api_requests_total{status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(vad_api_requests_total[5m])), 1e-9)",
     "legendFormat": "errors",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Time per pipeline step (p95)",
