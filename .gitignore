# ---- editor / python
.vscode/
__pycache__/
*.pyc
.pytest_cache/

# ---- data: raw data is versioned by DVC (*.dvc files); the rest is re-created by dvc repro
data/raw/_kaggle_tmp/
data/raw/_download/
data/processed/
data/features/
data/external/

# ---- outputs: small JSON / CSV results ARE committed (for `dvc metrics diff`); big files are not
outputs/training/*/checkpoints/
outputs/training/*/log.csv
outputs/training/*_smoke/
outputs/evaluation/*_smoke/
outputs/evaluation/*/scores/
outputs/behavior/*/events/
outputs/api/
outputs/demo/
*.pth
*.pt
*.tmp

# ---- downloaded: pretrained weights (python -m src.models.nets download ...) and third-party code
#      (python third_party/fetch.py; not republished, see third_party/README.md)
weights/
third_party/ASTT/

# ---- made by run_all.sh when conda is missing
.venv/
run_all.log
